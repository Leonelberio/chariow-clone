generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ——— Auth.js ———

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  memberships   OrganizationMember[]
  invitations   Invitation[]         @relation("InvitedBy")
  notifications Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ——— Organizations ———

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

enum BusinessType {
  RETAIL
  RESTAURANT
  SERVICES
  DISTRIBUTION
  TRAINING
  OTHER
}

enum OnboardingStep {
  WELCOME
  BUSINESS_INFO
  BRANDING
  STORE_PREVIEW
  COMPLETED
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  legalName   String?
  businessType BusinessType @default(OTHER)
  description String?      @db.Text
  logoUrl     String?
  phone       String?
  email       String?
  address     String?
  country     String?
  city        String?
  currency    String       @default("EUR")
  language    String       @default("fr")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  onboarding OrganizationOnboarding?
  members    OrganizationMember[]
  store      Store?
  categories Category[]
  products   Product[]
  customers  Customer[]
  orders     Order[]
  invitations Invitation[]
  notifications Notification[]

  @@index([name])
}

model OrganizationOnboarding {
  id             String          @id @default(cuid())
  organizationId String          @unique
  currentStep    OnboardingStep  @default(WELCOME)
  completedAt    DateTime?
  payload        Json            @default("{}")
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(STAFF)
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           OrganizationRole @default(STAFF)
  token          String           @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
}

// ——— Store ———

enum StoreTheme {
  CLASSIC
  MODERN
}

model Store {
  id              String     @id @default(cuid())
  organizationId  String     @unique
  name            String
  slug            String     @unique
  description     String?    @db.Text
  logoUrl         String?
  coverImageUrl   String?
  primaryColor    String     @default("#FFCC00")
  theme           StoreTheme @default(MODERN)
  published       Boolean    @default(false)
  contactEmail    String?
  contactPhone    String?
  deliveryInfo    String?    @db.Text
  paymentInfo     String?    @db.Text
  customDomain    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([slug])
}

// ——— Catalog ———

enum ProductType {
  PHYSICAL
  SERVICE
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Product {
  id               String        @id @default(cuid())
  organizationId   String
  categoryId       String?
  type             ProductType
  status           ProductStatus @default(DRAFT)
  name             String
  slug             String
  description      String?       @db.Text
  priceCents       Int
  compareAtCents   Int?
  sku              String?
  stockQuantity    Int?
  durationMinutes  Int?
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images       ProductImage[]
  variants     ProductVariant[]
  orderItems   OrderItem[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id             String  @id @default(cuid())
  productId      String
  name           String
  sku            String?
  priceCents     Int?
  stockQuantity  Int?
  attributes     Json    @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ——— Customers ———

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  phone          String?
  firstName      String?
  lastName       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

// ——— Orders ———

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  CONFIRMED
  PROCESSING
  READY
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id               String      @id @default(cuid())
  organizationId   String
  customerId       String?
  orderNumber      String
  status           OrderStatus @default(PENDING)
  currency         String      @default("EUR")
  subtotalCents    Int
  shippingCents    Int         @default(0)
  discountCents    Int         @default(0)
  totalCents       Int
  customerEmail    String
  customerPhone    String?
  customerName     String?
  shippingAddress  Json?
  internalNotes    String?     @db.Text
  promoCode        String?
  placedAt         DateTime    @default(now())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  statusHistory OrderStatusHistory[]
  payments     Payment[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  productId         String?
  variantId         String?
  productName       String
  variantName       String?
  sku               String?
  quantity          Int
  unitPriceCents    Int
  lineTotalCents    Int
  createdAt         DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  fromStatus OrderStatus?
  toStatus  OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ——— Payments ———

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  MANUAL
  STRIPE
}

model Payment {
  id             String          @id @default(cuid())
  orderId        String
  provider       PaymentProvider @default(MANUAL)
  status         PaymentStatus   @default(PENDING)
  amountCents    Int
  currency       String          @default("EUR")
  externalId     String?
  metadata       Json            @default("{}")
  paidAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ——— Notifications ———

enum NotificationType {
  NEW_ORDER
  ORDER_STATUS
  SYSTEM
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String?
  type           NotificationType
  title          String
  body           String?
  readAt         DateTime?
  metadata       Json             @default("{}")
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, readAt])
}
